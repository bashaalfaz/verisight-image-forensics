# Development: use a local MongoDB server or your MongoDB Atlas URI.
SECRET_KEY=replace-with-a-long-random-secret
MONGO_URI=mongodb://127.0.0.1:27017/deepsight
# Atlas example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/deepsight?retryWrites=true&w=majority
COOKIE_SECURE=false
FLASK_DEBUG=true
HOST=127.0.0.1
PORT=5000
UPLOAD_DIR=instance/uploads
MODEL_VERSION=DeepSight_CustomCNN
RATELIMIT_STORAGE_URI=memory://
